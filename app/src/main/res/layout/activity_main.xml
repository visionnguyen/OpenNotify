<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/permBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#33FFB300"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chưa cấp quyền đọc thông báo — OpenNotify chưa nhận được gì." />

            <Button
                android:id="@+id/permButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cấp quyền" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/emptyView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:text="Chưa theo dõi ứng dụng nào.\nBấm dấu + để thêm ứng dụng cần lấy thông báo."
        android:textColor="@color/muted"
        android:visibility="gone" />

    <TextView
        android:id="@+id/addFab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:background="@drawable/bg_fab"
        android:clickable="true"
        android:contentDescription="Thêm ứng dụng"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="30sp" />
</FrameLayout>
