<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên webhook" />
        <EditText
            android:id="@+id/whNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: Server kế toán"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Webhook URL" />
        <EditText
            android:id="@+id/whUrlField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://your-backend.example.com/opennotify"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Webhook Secret (HMAC)" />
        <EditText
            android:id="@+id/whSecretField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ lọc pattern"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Regex, không phân biệt hoa/thường, đối chiếu với title + text + big text + sub text + lines. Không có pattern nào = nhận mọi thông báo của ứng dụng."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/modeOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOẶC — khớp một trong các pattern" />

            <RadioButton
                android:id="@+id/modeAnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VÀ — phải khớp tất cả các pattern" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/patternContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addPatternButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Thêm pattern" />

        <CheckBox
            android:id="@+id/whEnabledField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Đang bật" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gửi sự kiện test tới webhook" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu" />
    </LinearLayout>
</ScrollView>
