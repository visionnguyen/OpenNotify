<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/scanQrButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quét mã QR cấu hình" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Tiện ích nhập nhanh: mã QR chỉ điền sẵn các ô bên dưới, mọi ô vẫn nhập/sửa tay được (chuẩn OpenNotify Webhook v1)."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/stoppedWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="⚠ Bên nhận đã báo không còn nhận ở địa chỉ/id này (404/410) nên webhook đã ngừng gửi. Sửa cấu hình hoặc quét lại mã QR rồi Lưu để gửi lại."
            android:textColor="@color/uptime_down"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tên webhook" />
        <EditText
            android:id="@+id/whNameField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ví dụ: Server kế toán"
            android:importantForAutofill="no"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Webhook URL" />
        <EditText
            android:id="@+id/whUrlField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://your-backend.example.com/opennotify"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bảo mật" />
        <RadioGroup
            android:id="@+id/securityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/securityHmac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HMAC — gửi JSON rõ, ký bằng secret" />

            <RadioButton
                android:id="@+id/securityAes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã hóa AES-GCM — chỉ bên có khóa đọc được" />
        </RadioGroup>

        <TextView
            android:id="@+id/secretLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Secret" />
        <EditText
            android:id="@+id/whSecretField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <TextView
            android:id="@+id/endpointIdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ID endpoint" />
        <EditText
            android:id="@+id/whEndpointIdField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="A–Z a–z 0–9 - _, tối đa 64 ký tự"
            android:importantForAutofill="no"
            android:inputType="text" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:background="@color/divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ lọc pattern"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/patternHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Regex, không phân biệt hoa/thường, đối chiếu với nội dung thông báo (title + text + big text + sub text + lines). Không có pattern nào = nhận mọi thông báo của ứng dụng."
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/modeOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOẶC — khớp một trong các pattern" />

            <RadioButton
                android:id="@+id/modeAnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VÀ — phải khớp tất cả các pattern" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/patternContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/addPatternButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Thêm pattern" />

        <CheckBox
            android:id="@+id/normalizeField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Chuẩn hóa trước khi so: viết hoa, bỏ dấu cách và ký tự không phải chữ/số" />

        <CheckBox
            android:id="@+id/whEnabledField"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:checked="true"
            android:text="Đang bật" />

        <Button
            android:id="@+id/testButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Gửi sự kiện test tới webhook" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lưu" />
    </LinearLayout>
</ScrollView>
