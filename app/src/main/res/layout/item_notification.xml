<?xml version="1.0" encoding="utf-8"?>
<!-- Nút Xóa nằm dưới, phần nội dung (nForeground) trượt sang trái khi vuốt để lộ nút này. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/nDelete"
        android:layout_width="@dimen/swipe_delete_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@color/badge"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="Xóa"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/nForeground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/nTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/nPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/nMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
