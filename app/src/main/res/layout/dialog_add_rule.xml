<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Package nguồn (ví dụ com.mbmobile)" />
    <EditText
        android:id="@+id/dialogPkg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Pattern (regex, để trống = khớp mọi thông báo)" />
    <EditText
        android:id="@+id/dialogPattern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ví dụ: (\+|\-)\s*[\d.,]+\s*(VND|VNĐ)" />

    <CheckBox
        android:id="@+id/dialogEnabled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bật luật này ngay" />

</LinearLayout>
